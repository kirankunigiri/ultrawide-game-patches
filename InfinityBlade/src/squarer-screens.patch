@@ -173,8 +174,10 @@ void install_dev_ipa_fix() {
     std::string data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
     std::string dir = vfs::host_home() + "/Library/Caches/port", path = dir + "/SwordGame.xxx";
