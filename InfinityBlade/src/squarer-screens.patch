 src/game/game.h          |  10 ++-
 src/game/widescreen.cpp  | 136 +++++++++++++++++++++++++++++++++++----
 src/port/android/app.cpp |  10 ++-
 4 files changed, 146 insertions(+), 17 deletions(-)

